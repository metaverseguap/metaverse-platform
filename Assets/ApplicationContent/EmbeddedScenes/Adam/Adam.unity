      value: "\u0427\u0430\u0441\u044B \u043F\u043E\u043A\u0430\u0437\u044B\u0432\u0430\u044E\u0442
        \u0432\u0440\u0435\u043C\u044F \u043F\u0440\u043E\u0448\u0435\u0434\u0448\u0435\u0435
        \u043E\u0442 \u0441\u043E\u0437\u0434\u0430\u043D\u0438\u044F \u0434\u0430\u043D\u043D\u043E\u0439
        \u043A\u043E\u043C\u043D\u0430\u0442\u044B. \u041D\u043E \u0438\u0434\u0443\u0442
