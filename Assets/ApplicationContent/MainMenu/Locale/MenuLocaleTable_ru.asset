    m_Metadata:
      m_Items: []
  - m_Id: 4758828447178752
    m_Localized: "\u0420\u043E\u043B\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 7179512364408832
    m_Localized: "\u041E\u0431\u043D\u043E\u0432\u0438\u0442\u044C \u0440\u043E\u043B\u0438
      \u0438 \u043F\u0440\u0430\u0432\u0430 (\u0440\u0430\u0437\u0440\u0435\u0448\u0435\u043D\u0438\u044F)"
    m_Metadata:
      m_Items: []
  - m_Id: 7181097236701184
    m_Localized: "\u041F\u0440\u0430\u0432\u0430 \u0440\u043E\u043B\u0438 (\u0440\u0430\u0437\u0440\u0435\u0448\u0435\u043D\u0438\u044F)"
    m_Metadata:
      m_Items: []
  - m_Id: 7181424472104960
    m_Localized: "\u041E\u0431\u043D\u043E\u0432\u0438\u0442\u044C \u043F\u0440\u0430\u0432\u0430
      \u0440\u043E\u043B\u0438 (\u0440\u0430\u0437\u0440\u0435\u0448\u0435\u043D\u0438\u044F)"
    m_Metadata:
      m_Items: []
  - m_Id: 7183905524555776
    m_Localized: "\u0420\u043E\u043B\u0438 \u043F\u0440\u0438\u043B\u043E\u0436\u0435\u043D\u0438\u044F
      \u0445\u0440\u0430\u044F\u043D\u044F\u0442\u044C\u0441\u044F \u0432 \u0444\u0430\u0439\u043B\u0435
      `AppRole.cs`. \u041F\u0440\u0430\u0432\u0430 (\u0440\u0430\u0437\u0440\u0435\u0448\u0435\u043D\u0438\u044F)
      \u0445\u0440\u0430\u043D\u044F\u0442\u0441\u044F \u0432 \u0444\u0430\u0439\u043B\u0435
      `AppPermission.cs`. \u0414\u043B\u044F \u0441\u0438\u043D\u0445\u0440\u043E\u043D\u0438\u0437\u0430\u0446\u0438\u0438
      \u0434\u0430\u043D\u043D\u044B\u0445 \u0444\u0430\u0439\u043B\u043E\u0432 \u0441
      \u0441\u0435\u0440\u0432\u0435\u0440\u043E\u043C \u043D\u0430\u0436\u043C\u0438\u0442\u0435
      `\u041E\u0431\u043D\u043E\u0432\u0438\u0442\u044C \u0440\u043E\u043B\u0438
      \u0438 \u043F\u0440\u0430\u0432\u0430 (\u0440\u0430\u0437\u0440\u0435\u0448\u0435\u043D\u0438\u044F)`"
    m_Metadata:
      m_Items: []
  - m_Id: 7188135303979008
    m_Localized: "\u0423\u0434\u0430\u043B\u0438\u0442\u044C \u0440\u043E\u043B\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 7272998270935040
    m_Localized: "\u041D\u0430\u0439\u0434\u0435\u043D\u043D\u044B\u0435 \u0430\u0441\u0441\u0435\u0442\u044B
      \u0441\u0446\u0435\u043D"
    m_Metadata:
      m_Items: []
  - m_Id: 7273482918567936
    m_Localized: "\u0417\u0430\u0433\u0440\u0443\u0437\u0438\u0442\u044C \u0430\u0441\u0441\u0435\u0442\u044B
      \u043D\u0430 \u0441\u0435\u0440\u0432\u0435\u0440"
    m_Metadata:
      m_Items: []
  - m_Id: 7647847417913344
    m_Localized: "\u041B\u043E\u043A\u0430\u043B\u044C\u043D\u043E"
    m_Metadata:
      m_Items: []
  - m_Id: 7948312970010624
    m_Localized: "\u0423\u0434\u0430\u043B\u0438\u0442\u044C \u0430\u0441\u0441\u0435\u0442\u044B
      \u0441 \u0441\u0435\u0440\u0432\u0435\u0440\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 7948913216856064
    m_Localized: "\u0417\u0430\u0433\u0440\u0443\u0436\u0430\u0435\u043C\u044B\u0435
      \u0430\u0441\u0441\u0435\u0442\u044B"
    m_Metadata:
      m_Items: []
  - m_Id: 7951784943558656
    m_Localized: "\u0423\u0441\u0442\u0440\u043E\u0439\u0441\u0442\u0432\u043E"
    m_Metadata:
      m_Items: []
  - m_Id: 7978578128150528
    m_Localized: "\u0412\u044B\u0431\u0435\u0440\u0438\u0442\u0435 \u0438\u0437\u043E\u0431\u0440\u0430\u0436\u0435\u043D\u0438\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 7982966074777600
    m_Localized: "\u0412\u0432\u0435\u0434\u0438\u0442\u0435 \u043E\u0442\u043E\u0431\u0440\u0430\u0436\u0430\u0435\u043C\u043E\u0435
      \u0438\u043C\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 7984432755777536
    m_Localized: "\u0418\u043D\u0434\u0435\u043A\u0441 \u0441\u043E\u0440\u0442\u0438\u0440\u043E\u0432\u043A\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 7985503481896960
    m_Localized: "\u0418\u0437\u043E\u0431\u0440\u0430\u0436\u0435\u043D\u0438\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 8277080603369472
    m_Localized: "\u0421\u0435\u0440\u0432\u0435\u0440"
    m_Metadata:
      m_Items: []
  - m_Id: 8643583613870080
    m_Localized: "\u0415\u0441\u043B\u0438 \u0438\u043C\u044F \u0444\u0430\u0439\u043B\u0430
      \u043E\u0442\u043C\u0435\u0447\u0435\u043D\u043E \u0441\u0435\u0440\u044B\u043C,
      \u0437\u043D\u0430\u0447\u0438\u0442 \u0438\u043D\u0444\u043E\u0440\u043C\u0430\u0446\u0438\u044F
      \u043E bundle \u0435\u0441\u0442\u044C \u043D\u0430 \u0441\u0435\u0440\u0432\u0435\u0440\u0435,
      \u043D\u043E \u0432 \u043F\u0440\u0438\u043B\u043E\u0436\u0435\u043D\u0438\u0438
      \u0444\u0430\u043B\u0439 \u043E\u0442\u0441\u0443\u0442\u0441\u0442\u0432\u0443\u0435\u0442.
      \u0422\u0430\u043A\u043E\u0439 bundle \u043D\u0435\u043B\u044C\u0437\u044F
      \u0437\u0430\u0433\u0440\u0443\u0437\u0438\u0442\u044C \u043D\u0430 \u0441\u0435\u0440\u0432\u0435\u0440,
      \u043D\u043E \u043C\u043E\u0436\u043D\u043E \u0443\u0434\u0430\u043B\u0438\u0442\u044C
      \u0441 \u0441\u0435\u0440\u0432\u0435\u0440\u0430, \u0435\u0441\u043B\u0438
      \u043E\u043D \u0431\u043E\u043B\u044C\u0448\u0435 \u043D\u0435 \u043D\u0443\u0436\u0435\u043D."
    m_Metadata:
      m_Items: []
  - m_Id: 8643900405456896
    m_Localized: "\u041F\u0435\u0440\u0435\u0434 \u0437\u0430\u0433\u0440\u0443\u0437\u043A\u043E\u0439
      \u0441\u0446\u0435\u043D \u043D\u0430 \u0441\u0435\u0440\u0432\u0435\u0440,
      \u043D\u0435\u043E\u0431\u0445\u043E\u0434\u0438\u043C\u043E \u0441\u043E\u0431\u0440\u0430\u0442\u044C
      \u0444\u0430\u0439\u043B\u044B bundle-\u043E\u0432. \u0414\u043B\u044F \u044D\u0442\u043E\u0433\u043E
      \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u0443\u0439\u0442\u0435 \u043C\u0435\u043D\u044E
      Assets->Build Asset Bundle->Scene. \u041F\u043E\u0441\u043B\u0435 \u0441\u0431\u043E\u0440\u043A\u0438
      \u0444\u0430\u0439\u043B\u044B \u0441\u043E\u0431\u0440\u0430\u043D\u043D\u044B\u0445
      bundle-\u043E\u0432 \u0431\u0443\u0434\u0443\u0442 \u043E\u0442\u043E\u0431\u0440\u0430\u0436\u0435\u043D\u044B
      \u0432 \u0441\u043F\u0438\u0441\u043A\u0435. "
    m_Metadata:
      m_Items: []
  - m_Id: 8644745125699584
    m_Localized: "\u041F\u0435\u0440\u0435\u0434 \u0437\u0430\u0433\u0440\u0443\u0437\u043A\u043E\u0439
      \u0430\u0432\u0430\u0442\u0430\u0440\u043E\u0432 \u043D\u0430 \u0441\u0435\u0440\u0432\u0435\u0440,
      \u043D\u0435\u043E\u0431\u0445\u043E\u0434\u0438\u043C\u043E \u0441\u043E\u0431\u0440\u0430\u0442\u044C
