      \u0421\u043D\u0430\u0447\u0430\u043B\u0430 \u0443\u0434\u0430\u043B\u0438\u0442\u0435
      \u0434\u0430\u043D\u043D\u044B\u0435 \u0430\u0441\u0441\u0435\u0442\u044B \u0441
      \u0441\u0435\u0440\u0432\u0435\u0440\u0430, \u0430 \u0437\u0430\u0442\u0435\u043C
      \u043F\u043E\u0432\u0442\u043E\u0440\u043D\u043E \u0437\u0430\u0433\u0440\u0443\u0437\u0438\u0442\u0435"
