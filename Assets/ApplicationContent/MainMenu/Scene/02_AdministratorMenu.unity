  m_text: "\u0415\u0441\u043B\u0438 \u0438\u043C\u044F \u0444\u0430\u0439\u043B\u0430
    \u043E\u0442\u043C\u0435\u0447\u0435\u043D\u043E \u0441\u0435\u0440\u044B\u043C,
    \u0437\u043D\u0430\u0447\u0438\u0442 \u0438\u043D\u0444\u043E\u0440\u043C\u0430\u0446\u0438\u044F
    \u043E bundle \u0435\u0441\u0442\u044C \u043D\u0430 \u0441\u0435\u0440\u0432\u0435\u0440\u0435,
    \u043D\u043E \u0432 \u043F\u0440\u0438\u043B\u043E\u0436\u0435\u043D\u0438\u0438
    \u0444\u0430\u043B\u0439 \u043E\u0442\u0441\u0443\u0442\u0441\u0442\u0432\u0443\u0435\u0442.
    \u0422\u0430\u043A\u043E\u0439 bundle \u043D\u0435\u043B\u044C\u0437\u044F \u0437\u0430\u0433\u0440\u0443\u0437\u0438\u0442\u044C
    \u043D\u0430 \u0441\u0435\u0440\u0432\u0435\u0440, \u043D\u043E \u043C\u043E\u0436\u043D\u043E
    \u0443\u0434\u0430\u043B\u0438\u0442\u044C \u0441 \u0441\u0435\u0440\u0432\u0435\u0440\u0430,
    \u0435\u0441\u043B\u0438 \u043E\u043D \u0431\u043E\u043B\u044C\u0448\u0435 \u043D\u0435
    \u043D\u0443\u0436\u0435\u043D."
