    - target: {fileID: 4639988354338192832, guid: 2e4f53083e3efbd4c8c589979a5ed410, type: 3}
      propertyPath: m_text
      value: "\u0427\u0430\u0441\u044B \u043F\u043E\u043A\u0430\u0437\u044B\u0432\u0430\u044E\u0442
        \u0432\u0440\u0435\u043C\u044F \u043F\u0440\u043E\u0448\u0435\u0434\u0448\u0435\u0435
        \u043E\u0442 \u0441\u043E\u0437\u0434\u0430\u043D\u0438\u044F \u0434\u0430\u043D\u043D\u043E\u0439
        \u043A\u043E\u043C\u043D\u0430\u0442\u044B. \u041D\u043E \u0438\u0434\u0443\u0442
        \u0447\u0430\u0441\u044B \u043B\u043E\u043A\u0430\u043B\u044C\u043D\u043E.
        \u0412\u044B \u043C\u043E\u0436\u0435\u0442\u0435 \u0440\u0430\u0441\u0441\u0438\u043D\u0445\u0440\u043E\u043D\u0438\u0437\u0438\u0440\u043E\u0432\u0430\u0442\u044C
        \u0438\u0445 \u0441 \u0441\u0435\u0440\u0432\u0435\u0440\u043E\u043C \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u0443\u044F
        \u043A\u043D\u043E\u043F\u043A\u0438 1 \u0438 2. \u0418 \u0432\u043E\u0441\u0441\u0442\u0430\u043D\u043E\u0432\u0438\u0442\u044C
        \u0441\u0438\u043D\u0445\u0440\u043E\u043D\u0438\u0437\u0430\u0446\u0438\u044E
        \u043A\u043D\u043E\u043F\u043A\u043E\u0439 3"
      objectReference: {fileID: 0}
    - target: {fileID: 6248519243133270115, guid: 2e4f53083e3efbd4c8c589979a5ed410, type: 3}
      propertyPath: m_text
      value: "\u041B\u043E\u043A\u0430\u043B\u044C\u043D\u0430\u044F \u0441\u0438\u043D\u0445\u0440\u043E\u043D\u0438\u0437\u0430\u0446\u0438\u044F"
